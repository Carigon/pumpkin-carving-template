{
  "name": "pumpkin-carving-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "lint": "eslint .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:static": "npm run typecheck && npm run lint && npm run knip",
    "check": "npm run check:static && npm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "knip": "^6.42.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "esm-potrace-wasm": "^0.5.1",
    "pdf-lib": "^1.17.1",
    "svgpath": "^2.6.0",
    "three": "^0.186.1"
  }
}
